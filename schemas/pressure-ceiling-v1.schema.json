{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rmednitzer/mira/blob/main/schemas/pressure-ceiling-v1.schema.json",
  "title": "MIRA explicit pressure-ceiling investigation v1",
  "$comment": "Structure, resource/source binding and reason/outcome/availability agreement only. The relationship between some_avg10_basis_points and the ceiling is a semantic check outside JSON Schema.",
  "type": "object",
  "required": [
    "investigation_version",
    "template",
    "scope",
    "expectation",
    "assessment",
    "application_health",
    "root_cause",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "investigation_version": {
      "const": 1
    },
    "template": {
      "const": "pressure-ceiling/v1"
    },
    "scope": {
      "const": "local/procfs"
    },
    "expectation": {
      "type": "object",
      "required": [
        "resource",
        "max_some_avg10_basis_points"
      ],
      "additionalProperties": false,
      "properties": {
        "resource": {
          "enum": [
            "cpu",
            "memory",
            "io"
          ]
        },
        "max_some_avg10_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "outcome",
        "reason",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "satisfied",
            "not_satisfied",
            "indeterminate"
          ]
        },
        "reason": {
          "enum": [
            "within_ceiling",
            "above_ceiling",
            "evidence_unavailable"
          ]
        },
        "evidence_ref": {
          "const": "#/evidence"
        }
      }
    },
    "application_health": {
      "const": "not_assessed"
    },
    "root_cause": {
      "const": "not_assessed"
    },
    "evidence": {
      "allOf": [
        {
          "$ref": "https://github.com/rmednitzer/mira/blob/main/schemas/evidence-v2.schema.json"
        },
        {
          "properties": {
            "source": {
              "enum": [
                "/proc/pressure/cpu",
                "/proc/pressure/memory",
                "/proc/pressure/io"
              ]
            },
            "scope": {
              "type": "null"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "within_ceiling"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "satisfied"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "above_ceiling"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "not_satisfied"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "evidence_unavailable"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "indeterminate"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expectation": {
            "properties": {
              "resource": {
                "const": "cpu"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "source": {
                "const": "/proc/pressure/cpu"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expectation": {
            "properties": {
              "resource": {
                "const": "memory"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "source": {
                "const": "/proc/pressure/memory"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expectation": {
            "properties": {
              "resource": {
                "const": "io"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "source": {
                "const": "/proc/pressure/io"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "evidence_unavailable"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "enum": [
                  "within_ceiling",
                  "above_ceiling"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
