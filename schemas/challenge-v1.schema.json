{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rmednitzer/mira/blob/main/schemas/challenge-v1.schema.json",
  "title": "MIRA consumer challenge v1 (ADR 0014)",
  "$comment": "Printed by `mira challenge` and kept by the consumer. issued_unix_ms is the issuing machine's wall clock and never leaves the consumer. Consumers also require the exact byte layout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_version",
    "challenge",
    "issued_unix_ms"
  ],
  "properties": {
    "challenge_version": {
      "const": 1
    },
    "challenge": {
      "type": "string",
      "pattern": "^(?!.*\\n)[0-9a-f]{64}$"
    },
    "issued_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999999999
    }
  }
}
