{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rmednitzer/mira/blob/main/schemas/uptime-minimum-v1.schema.json",
  "title": "MIRA explicit uptime-minimum investigation v1",
  "$comment": "Structure, source binding and reason/outcome/availability agreement only. Whether the observed whole uptime meets the minimum is a semantic check outside JSON Schema.",
  "type": "object",
  "required": [
    "investigation_version",
    "template",
    "scope",
    "expectation",
    "assessment",
    "application_health",
    "root_cause",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "investigation_version": {
      "const": 1
    },
    "template": {
      "const": "uptime-minimum/v1"
    },
    "scope": {
      "const": "local/procfs"
    },
    "expectation": {
      "type": "object",
      "required": [
        "minimum_uptime_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "minimum_uptime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "outcome",
        "reason",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "satisfied",
            "not_satisfied",
            "indeterminate"
          ]
        },
        "reason": {
          "enum": [
            "minimum_met",
            "below_minimum",
            "evidence_unavailable"
          ]
        },
        "evidence_ref": {
          "const": "#/evidence"
        }
      }
    },
    "application_health": {
      "const": "not_assessed"
    },
    "root_cause": {
      "const": "not_assessed"
    },
    "evidence": {
      "allOf": [
        {
          "$ref": "https://github.com/rmednitzer/mira/blob/main/schemas/evidence-v2.schema.json"
        },
        {
          "properties": {
            "source": {
              "const": "/proc/uptime"
            },
            "scope": {
              "type": "null"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "minimum_met"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "satisfied"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "below_minimum"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "not_satisfied"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "evidence_unavailable"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "indeterminate"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "evidence_unavailable"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "enum": [
                  "minimum_met",
                  "below_minimum"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
