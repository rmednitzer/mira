{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rmednitzer/mira/blob/main/schemas/memory-headroom-v1.schema.json",
  "title": "MIRA explicit memory-headroom investigation v1",
  "type": "object",
  "required": [
    "investigation_version",
    "template",
    "scope",
    "assessment",
    "application_health",
    "root_cause",
    "evidence",
    "expectation"
  ],
  "additionalProperties": false,
  "properties": {
    "investigation_version": {
      "const": 1
    },
    "template": {
      "const": "memory-headroom/v1"
    },
    "scope": {
      "const": "local/procfs"
    },
    "assessment": {
      "type": "object",
      "required": [
        "outcome",
        "reason",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "satisfied",
            "not_satisfied",
            "indeterminate"
          ]
        },
        "reason": {
          "enum": [
            "minimum_met",
            "below_minimum",
            "evidence_unavailable"
          ]
        },
        "evidence_ref": {
          "const": "#/evidence"
        }
      }
    },
    "application_health": {
      "const": "not_assessed"
    },
    "root_cause": {
      "const": "not_assessed"
    },
    "evidence": {
      "allOf": [
        {
          "$ref": "https://github.com/rmednitzer/mira/blob/main/schemas/evidence-v1.schema.json"
        },
        {
          "properties": {
            "source": {
              "const": "/proc/meminfo"
            },
            "scope": {
              "type": "null"
            },
            "value": {
              "properties": {
                "total_kib": {
                  "maximum": 18446744073709551615
                },
                "available_kib": {
                  "maximum": 18446744073709551615
                }
              }
            }
          }
        }
      ]
    },
    "expectation": {
      "type": "object",
      "required": [
        "minimum_available_kib"
      ],
      "additionalProperties": false,
      "properties": {
        "minimum_available_kib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "minimum_met"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "satisfied"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "below_minimum"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "not_satisfied"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "reason": {
                "const": "evidence_unavailable"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "outcome": {
                "const": "indeterminate"
              }
            }
          }
        }
      }
    }
  ]
}
