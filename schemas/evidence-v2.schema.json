{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rmednitzer/mira/blob/main/schemas/evidence-v2.schema.json",
  "title": "MIRA evidence record v2",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "scope",
    "recorded_unix_ms",
    "clock_trust",
    "freshness",
    "status",
    "value",
    "error_kind",
    "elapsed_ms",
    "failure_reason"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source": {
      "enum": [
        "/proc/meminfo",
        "/proc/uptime",
        "/proc/sys/kernel/osrelease",
        "/proc/pressure/cpu",
        "/var/lib/dpkg/status",
        "systemd/system",
        "/proc/pressure/memory",
        "/proc/pressure/io"
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_unix_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 340282366920938463463374607431768211455
    },
    "clock_trust": {
      "const": "unverified"
    },
    "freshness": {
      "const": "unknown"
    },
    "status": {
      "enum": [
        "observed",
        "unavailable"
      ]
    },
    "value": {},
    "error_kind": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "elapsed_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 340282366920938463463374607431768211455
    },
    "failure_reason": {
      "enum": [
        null,
        "timeout",
        "limit_exceeded",
        "malformed_data",
        "permission_denied",
        "not_found",
        "backend_failed",
        "io_failure"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "error_kind": {
            "type": "string"
          },
          "failure_reason": {
            "enum": [
              "timeout",
              "limit_exceeded",
              "malformed_data",
              "permission_denied",
              "not_found",
              "backend_failed",
              "io_failure"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "error_kind": {
            "type": "null"
          },
          "failure_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "systemd/system"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "scope": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "/proc/meminfo"
          },
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "source",
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "total_kib",
              "available_kib"
            ],
            "additionalProperties": false,
            "properties": {
              "total_kib": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18446744073709551615
              },
              "available_kib": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "/proc/uptime"
          },
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "source",
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "/proc/sys/kernel/osrelease"
          },
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "source",
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^(?!.*\\n)[A-Za-z0-9._+-]{1,256}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "enum": [
              "/proc/pressure/cpu",
              "/proc/pressure/memory",
              "/proc/pressure/io"
            ]
          },
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "source",
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "some_avg10_basis_points",
              "full_avg10_basis_points"
            ],
            "additionalProperties": false,
            "properties": {
              "some_avg10_basis_points": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "full_avg10_basis_points": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "/var/lib/dpkg/status"
          },
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "source",
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "installed_count"
            ],
            "additionalProperties": false,
            "properties": {
              "installed_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "systemd/system"
          },
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "source",
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "id",
              "load_state",
              "active_state",
              "sub_state"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 9,
                "maxLength": 200,
                "pattern": "^(?!.*\\n)(?!-)(?:[A-Za-z0-9._@:-]|\\\\x[0-9A-Fa-f]{2})+\\.service$"
              },
              "load_state": {
                "type": "string",
                "pattern": "^(?!.*\\n)[\\x00-\\x7f]{1,256}$"
              },
              "active_state": {
                "type": "string",
                "pattern": "^(?!.*\\n)[\\x00-\\x7f]{1,256}$"
              },
              "sub_state": {
                "type": "string",
                "pattern": "^(?!.*\\n)[\\x00-\\x7f]{1,256}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "systemd/system"
          },
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "source",
          "status"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 9,
            "maxLength": 200,
            "pattern": "^(?!.*\\n)(?!-)(?:[A-Za-z0-9._@:-]|\\\\x[0-9A-Fa-f]{2})+\\.service$"
          }
        }
      }
    }
  ],
  "$comment": "Observed kernel release and systemd strings mirror the producer's lexical contract. States stay literal ASCII, including control characters that human output escapes. Patterns start with (?!.*\\n) because Python re lets $ match before a final newline."
}
