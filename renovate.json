{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Vienna",
  "schedule": [
    "* 2-6 * * 1"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "automerge": false,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ]
}
